# Postgres
POSTGRES_DB=healthos
POSTGRES_USER=healthos
# LOCAL DEVELOPMENT ONLY — NEVER USE IN PRODUCTION
POSTGRES_PASSWORD=local_dev_only_change_me

# Future: your FastAPI / app can reuse these:
# The API itself expects postgresql+asyncpg:// in the repo-root .env.
DATABASE_URL=postgresql+asyncpg://healthos:local_dev_only_change_me@localhost:5432/healthos
REDIS_URL=redis://localhost:6379/0

# Future: Weaviate + HAPI endpoints for app config
WEAVIATE_URL=http://localhost:8080
FHIR_BASE_URL=http://localhost:8082/fhir