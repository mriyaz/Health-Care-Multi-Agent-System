# Copy to ".env" in the repo root and fill in real values. Never commit ".env".
# Reference: README.md (Configuration) and api/settings.py.

# ---- Required for production-like runs ----
# Signing key for session cookies (minimum 32 characters). Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace_with_secure_random_value

# JWT signing (HS256 access + refresh tokens). Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_secure_random_value

# Database: either set DATABASE_URL, or set POSTGRES_* below (password required when DATABASE_URL is unset).
# LOCAL DEVELOPMENT ONLY. Use the same password as infra/.env. Never use this value in production.
DATABASE_URL=postgresql+asyncpg://healthos:local_dev_only_change_me@localhost:5432/healthos

# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=healthos
# POSTGRES_USER=healthos
# POSTGRES_PASSWORD=

# ---- App ----
APP_NAME=HealthOS API
ENV=local
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- Redis (sessions, Celery; adjust DB index if needed) ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS (comma-separated or JSON array) ----
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ---- Optional: Celery overrides ----
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ---- Optional: Weaviate ----
# WEAVIATE_HTTP_HOST=localhost
# WEAVIATE_HTTP_PORT=8080

# ---- OpenRouter (required for SOAP generation in dev) ----
# Get a key at https://openrouter.ai — pick model IDs your key can access.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Tier routing (playground / orchestrator defaults). Example dev model:
OPENROUTER_MODEL_DEV=meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL_PRODUCTION=meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL_DEMO=meta-llama/llama-3.1-8b-instruct

# Clinical Documentation Agent models (set each once — duplicates override silently)
DOCUMENTATION_SOAP_MODEL=meta-llama/llama-3.1-8b-instruct
DOCUMENTATION_DISCHARGE_MODEL=meta-llama/llama-3.1-8b-instruct
DOCUMENTATION_REFERRAL_MODEL=meta-llama/llama-3.1-8b-instruct
# DOCUMENTATION_MAX_UPLOAD_MB=50
# DOCUMENTATION_MAX_COMPLETION_TOKENS=4096

# Orchestrator LLM primary / fallback (stub specialist path)
ORCHESTRATOR_LLM_PRIMARY_MODEL=meta-llama/llama-3.1-8b-instruct
ORCHESTRATOR_LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# LangGraph checkpoints: postgres (default, durable) or memory (Windows fallback / tests)
HEALTHOS_ORCHESTRATOR_CHECKPOINTER=postgres

# Legacy alias (optional)
# XAI_API_KEY=

# ---- Optional: Grok / xAI (legacy LLM routes when enabled) ----
# GROK_API_KEY=
# GROK_API_BASE_URL=https://api.x.ai/v1

# ---- Optional: Langfuse (only when Langfuse stack is running on port 3000) ----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://127.0.0.1:3000

# ---- Optional: FHIR (HAPI / SMART / Subscriptions — Section B) ----
# HAPI_FHIR_BASE_URL=http://localhost:8082/fhir
# FHIR_ADAPTER_KIND=generic
# HEALTHOS_PUBLIC_BASE_URL=http://127.0.0.1:8000
# FHIR_WEBHOOK_SECRET=
# SMART_CLIENT_ID=
# SMART_CLIENT_SECRET=
# SMART_REDIRECT_URI=
